PORT=3000
MOCK_PORT=8787
# Shopify Admin API (system of record). Production: https://<shop>.myshopify.com
SHOPIFY_BASE_URL=http://localhost:8787
SHOPIFY_API_VERSION=2026-10
# Sent as X-Shopify-Access-Token, to Shopify only. Not needed for the mock; required for real Shopify.
SHOPIFY_ACCESS_TOKEN=
# Store tool and payment terminal; default to SHOPIFY_BASE_URL (the mock serves all three on one port)
# SMT_BASE_URL=
# TERMINAL_BASE_URL=
DB_PATH=data/till.db
CONFIG_DIR=config
# 1 = mock returns random 429/503 like production
MOCK_FLAKE=0
# TILL_TODAY=2026-10-23
